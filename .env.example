PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/concordia_social

# Federation whose tokens this service accepts — verified locally against
# its JWKS endpoint (/.well-known/jwks.json). No shared JWT secret.
FEDERATION_URL=https://federation.concordiachat.com

# CORS — comma-separated allowlist of browser origins. Unset = allow all (dev only).
CORS_ORIGINS=https://app.concordiachat.com

# Service-to-service key shared with the Federation (internal API)
INTERNAL_API_KEY=change_me
FEDERATION_INTERNAL_URL=http://localhost:3000
